# All settings are optional. The server starts with PORT=8080 by default.
PORT=8080
STATIC_DIR=dist
# Optional local override; containers default to /data/demo-workspaces.
DEMO_DATA_DIR=/data/demo-workspaces
# Production discovers the managed identity automatically. These are optional overrides.
DEMO_BLOB_ENDPOINT=https://sociobotblob.blob.core.windows.net
AZURE_CLIENT_ID=ba10d5bc-6375-4325-8892-4c7a5be500ca

# M2 will read these optional overrides, using Sociobot CIAM defaults otherwise.
ENTRA_TENANT_ID=35c6fe40-0ec0-46b6-98c6-213ad4de6650
ENTRA_TENANT_SUBDOMAIN=sociobotcustomers
ENTRA_CLIENT_ID=25c704f4-465a-47af-80ab-2c489466b697
